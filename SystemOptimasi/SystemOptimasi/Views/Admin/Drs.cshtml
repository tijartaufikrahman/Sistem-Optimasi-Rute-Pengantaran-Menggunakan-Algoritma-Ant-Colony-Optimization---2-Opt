@{
    ViewData["Title"] = "Delivery Run Sheet";
}

<div id="drsAlertArea"></div>

<!-- Data Card DRS -->
<div class="row">
    <div class="col-12">
        <div class="db-data-card">
            <div class="db-card-top">
                <h3 class="db-card-title"><i class="fas fa-clipboard-list" style="color:#ea580c;margin-right:.45rem;"></i> Tabel Delivery Run Sheet (DRS)</h3>
                <button class="db-btn-primary" onclick="openCreateDrsModal()"><i class="fas fa-plus"></i> Buat DRS Baru</button>
            </div>

            <!-- Controls: Status Filter, Length, Search -->
            <div class="db-card-controls">
                <div class="db-controls-left" style="display:flex;align-items:center;gap:15px;flex-wrap:wrap;">
                    <div style="display:flex;align-items:center;gap:6px;">
                        <span>Tampilkan</span>
                        <select id="drsLength" class="db-select"></select>
                    </div>
                    <div style="display:flex;align-items:center;gap:6px;">
                        <span style="font-weight:600;"><i class="fas fa-filter" style="color:#ea580c;"></i> Filter Status:</span>
                        <select id="drsStatusFilter" class="db-select" style="min-width:140px;">
                            <option value="Semua">Semua Status</option>
                            <option value="Assigned">Assigned</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Sudah Dioptimasi">Sudah Dioptimasi</option>
                            <option value="Completed">Completed</option>
                            <option value="Canceled">Canceled</option>
                        </select>
                    </div>
                    <div style="display:flex;align-items:center;gap:6px;">
                        <span style="font-weight:600;"><i class="fas fa-calendar-alt" style="color:#ea580c;"></i> Periode:</span>
                        <input type="date" id="drsTglAwal" class="db-select" style="padding:4px 8px;" />
                        <span>s/d</span>
                        <input type="date" id="drsTglAkhir" class="db-select" style="padding:4px 8px;" />
                        <button type="button" class="db-btn-outline" id="btnFilterDrsDate" style="padding:4px 10px;font-size:.82rem;"><i class="fas fa-search"></i></button>
                    </div>
                </div>
                <div class="db-controls-right">
                    <span>Cari:</span>
                    <input id="drsSearch" class="db-input-search" type="text" placeholder="No. DRS / Oranger..." />
                </div>
            </div>

            <!-- Table -->
            <div class="db-table-wrap">
                <table id="tableDrs" class="db-table">
                    <thead>
                        <tr>
                            <th class="db-th-center" style="width:50px;">#</th>
                            <th class="db-th-sortable">NO. DRS</th>
                            <th class="db-th-sortable">KANTOR / HUB</th>
                            <th class="db-th-sortable">ORANGER</th>
                            <th class="db-th-sortable">TANGGAL TUGAS</th>
                            <th class="db-th-sortable db-th-center">TOTAL KIRIMAN</th>
                            <th class="db-th-sortable">STATUS</th>
                            <th class="db-th-sortable">DIBUAT</th>
                            <th class="db-th-right" style="width:110px;">AKSI</th>
                        </tr>
                    </thead>
                    <tbody id="drsBody"></tbody>
                </table>
            </div>

            <!-- Footer Pagination -->
            <div class="db-card-footer">
                <div class="db-info-text" id="drsInfo">Menampilkan 0 - 0 dari 0 data</div>
                <div class="db-pagination" id="drsPaginate"></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Create DRS -->
<div id="modalCreateDrs" class="modal-overlay">
    <div class="modal-box" style="max-width:520px;">
        <div class="modal-header">
            <h3><i class="fas fa-plus-circle" style="color:#ea580c;margin-right:.45rem;"></i> Buat Delivery Run Sheet</h3>
            <button class="modal-close" onclick="closeModal('modalCreateDrs')">&times;</button>
        </div>
        <form id="formCreateDrs">
            <input type="hidden" name="NoDRS" id="createNoDRS" />
            <input type="hidden" name="StatusDRS" id="createStatusDRS" value="Assigned" />
            <div class="modal-body">
                <div class="form-group mb-3">
                    <label style="font-weight:600;font-size:.85rem;color:#334155;margin-bottom:.35rem;display:block;">
                        Oranger Pengantar <span style="color:#dc2626;">*</span>
                    </label>
                    <select name="OrangerId" id="createOrangerId" class="form-control" required>
                        <option value="">-- Pilih Oranger --</option>
                    </select>
                    <small style="color:#64748b;font-size:.76rem;margin-top:3px;display:block;">
                        *Hanya menampilkan user dengan RoleType Mobile (1) atau Akses Ganda (2).
                    </small>
                </div>

                <div class="form-group mb-3">
                    <label style="font-weight:600;font-size:.85rem;color:#334155;margin-bottom:.35rem;display:block;">
                        Tanggal Tugas <span style="color:#dc2626;">*</span>
                    </label>
                    <input type="date" name="TanggalTugas" id="createTanggalTugas" class="form-control" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="db-btn-outline" onclick="closeModal('modalCreateDrs')">Batal</button>
                <button type="submit" class="db-btn-primary"><i class="fas fa-save"></i> Simpan DRS</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Delete DRS -->
<div id="modalDeleteDrs" class="modal-overlay">
    <div class="modal-box" style="max-width:420px;">
        <div class="modal-header">
            <h3><i class="fas fa-exclamation-triangle" style="color:#dc2626;margin-right:.45rem;"></i> Hapus DRS</h3>
            <button class="modal-close" onclick="closeModal('modalDeleteDrs')">&times;</button>
        </div>
        <div class="modal-body">
            <p>Apakah Anda yakin ingin menghapus lembar tugas <strong id="deleteDrsNo"></strong>?</p>
            <p style="font-size:.82rem;color:#64748b;">Tindakan ini tidak dapat dibatalkan.</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="db-btn-outline" onclick="closeModal('modalDeleteDrs')">Batal</button>
            <button type="button" class="db-btn-danger" id="btnConfirmDeleteDrs"><i class="fas fa-trash"></i> Hapus</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(function () {
    var drsToDeleteId = null;
    var rawDrsList = [];
    var eligibleOrangers = [];

    function showAlert(msg, type) {
        var cls = type === 'success' ? 'db-alert-success' : 'db-alert-danger';
        var icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
        $('#drsAlertArea').html(
            '<div class="db-alert ' + cls + '"><i class="fas ' + icon + '"></i> ' + msg + '</div>'
        );
        setTimeout(function () {
            $('#drsAlertArea .db-alert').fadeOut(300, function () { $(this).remove(); });
        }, 3500);
    }

    window.openModal = function (id) {
        $('#' + id).addClass('active');
    };
    window.closeModal = function (id) {
        $('#' + id).removeClass('active');
    };
    $(document).on('click', '.modal-overlay', function (e) {
        if (e.target === this) $(this).removeClass('active');
    });

    function esc(str) {
        if (!str) return '';
        return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
    }

    var activeKodeKantor = 'KCP44188';

    function loadKantorInfo() {
        $.ajax({
            url: window.API_BASE_URL + '/api/kantor',
            type: 'GET',
            contentType: 'application/json',
            success: function (k) {
                if (k && k.kodeKantor) {
                    activeKodeKantor = k.kodeKantor.trim();
                }
            }
        });
    }

    window.generateDrsNumber = function (inputId) {
        var now = new Date();
        var yyyy = now.getFullYear();
        var mm = String(now.getMonth() + 1).padStart(2, '0');
        var dd = String(now.getDate()).padStart(2, '0');
        var hh = String(now.getHours()).padStart(2, '0');
        var min = String(now.getMinutes()).padStart(2, '0');
        var timeStamp = '' + yyyy + mm + dd + hh + min;

        $('#' + inputId).val(activeKodeKantor + '-' + timeStamp);
    };

    window.openCreateDrsModal = function () {
        var todayStr = new Date().toISOString().split('T')[0];
        $('#createTanggalTugas').val(todayStr);
        generateDrsNumber('createNoDRS');
        openModal('modalCreateDrs');
    };

    function DbTable(config) {
        this.config = config;
        this.data = [];
        this.filtered = [];
        this.page = 1;
        this.perPage = 10;
        this.sortCol = -1;
        this.sortAsc = true;
        this.search = '';
        this.statusFilter = 'Semua';
    }
    DbTable.prototype = {
        setData: function (data) {
            this.data = data;
            this.applyFilter();
        },
        applyFilter: function () {
            var s = this.search.toLowerCase();
            var sf = this.statusFilter;

            this.filtered = this.data.filter(function (row) {
                var matchStatus = (sf === 'Semua') || (row.statusDRS === sf);
                if (!matchStatus) return false;

                if (!s) return true;
                var content = [row.noDRS, row.namaOranger, row.namaKantor, row.tanggalTugas, row.statusDRS].join(' ').toLowerCase();
                return content.indexOf(s) > -1;
            });

            if (this.sortCol > -1) {
                var col = this.config.sortKeys[this.sortCol];
                var asc = this.sortAsc;
                this.filtered.sort(function (a, b) {
                    var va = (a[col] != null ? a[col] : '').toString().toLowerCase();
                    var vb = (b[col] != null ? b[col] : '').toString().toLowerCase();
                    return asc ? va.localeCompare(vb, undefined, { numeric: true }) : vb.localeCompare(va, undefined, { numeric: true });
                });
            }
            this.page = 1;
            this.render();
        },
        goTo: function (p) {
            var total = Math.ceil(this.filtered.length / this.perPage) || 1;
            if (p < 1) p = 1;
            if (p > total) p = total;
            this.page = p;
            this.render();
        },
        render: function () {
            var c = this.config;
            var start = (this.page - 1) * this.perPage;
            var end = start + this.perPage;
            var rows = this.filtered.slice(start, end);

            var html = '';
            if (rows.length === 0) {
                html = '<tr><td colspan="' + c.colCount + '" style="text-align:center;padding:2rem;color:#94a3b8;">Tidak ada data DRS tersedia</td></tr>';
            } else {
                for (var i = 0; i < rows.length; i++) {
                    html += c.renderRow(rows[i], start + i + 1);
                }
            }
            $(c.tbody).html(html);

            var total = this.filtered.length;
            var infoText = total === 0
                ? 'Tidak ada data'
                : 'Menampilkan ' + (start + 1) + ' - ' + Math.min(end, total) + ' dari ' + total + ' data';
            $(c.info).text(infoText);

            var $len = $(c.lengthSel);
            if ($len.children().length === 0) {
                $len.html('<option value="10">10</option><option value="25">25</option><option value="50">50</option>');
                $len.val(this.perPage);
                $len.on('change', function () {
                    this.perPage = parseInt($(this).val());
                    this.page = 1;
                    this.render();
                }.bind(this));
            }

            var $search = $(c.searchInput);
            $search.off('input').on('input', function () {
                this.search = $(this).val();
                this.applyFilter();
            }.bind(this));

            var totalPages = Math.ceil(total / this.perPage) || 1;
            var pagHtml = '';
            pagHtml += '<button class="db-page-btn" data-p="1" ' + (this.page === 1 ? 'disabled' : '') + '>Awal</button>';
            pagHtml += '<button class="db-page-btn" data-p="' + (this.page - 1) + '" ' + (this.page === 1 ? 'disabled' : '') + '><i class="fas fa-chevron-left"></i></button>';
            for (var p = 1; p <= totalPages; p++) {
                if (totalPages > 7 && p > 3 && p < totalPages - 2 && Math.abs(p - this.page) > 1) {
                    if (p === 4 || p === totalPages - 3) pagHtml += '<span style="padding:0 4px;color:#94a3b8;">...</span>';
                    continue;
                }
                pagHtml += '<button class="db-page-btn' + (p === this.page ? ' active' : '') + '" data-p="' + p + '">' + p + '</button>';
            }
            pagHtml += '<button class="db-page-btn" data-p="' + (this.page + 1) + '" ' + (this.page === totalPages ? 'disabled' : '') + '><i class="fas fa-chevron-right"></i></button>';
            pagHtml += '<button class="db-page-btn" data-p="' + totalPages + '" ' + (this.page === totalPages ? 'disabled' : '') + '>Akhir</button>';
            $(c.paginate).html(pagHtml);

            $(c.paginate).off('click', '.db-page-btn').on('click', '.db-page-btn', function () {
                var p = parseInt($(this).data('p'));
                if (!isNaN(p)) this.goTo(p);
            }.bind(this));

            $(c.table).find('thead th.db-th-sortable').off('click').on('click', function () {
                var idx = $(c.table).find('thead th.db-th-sortable').index(this);
                if (this.sortCol === idx) {
                    this.sortAsc = !this.sortAsc;
                } else {
                    this.sortCol = idx;
                    this.sortAsc = true;
                }
                this.applyFilter();
            }.bind(this));
        }
    };

    function getBadgeDrs(status) {
        switch (status) {
            case 'Assigned':
                return '<span class="db-badge" style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;">Assigned</span>';
            case 'In Progress':
                return '<span class="db-badge" style="background:#fff7ed;color:#ea580c;border:1px solid #fed7aa;">In Progress</span>';
            case 'Sudah Dioptimasi':
                return '<span class="db-badge" style="background:#f0fdfa;color:#0d9488;border:1px solid #99f6e4;">Sudah Dioptimasi</span>';
            case 'Completed':
                return '<span class="db-badge" style="background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;">Completed</span>';
            case 'Canceled':
                return '<span class="db-badge" style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;">Canceled</span>';
            default:
                return '<span class="db-badge">' + (status || '-') + '</span>';
        }
    }

    var drsTable = new DbTable({
        tbody: '#drsBody',
        info: '#drsInfo',
        lengthSel: '#drsLength',
        searchInput: '#drsSearch',
        paginate: '#drsPaginate',
        table: '#tableDrs',
        colCount: 9,
        sortKeys: ['noDRS', 'namaKantor', 'namaOranger', 'tanggalTugas', 'totalKiriman', 'statusDRS', 'createdAt'],
        renderRow: function (d, no) {
            return '<tr>' +
                '<td class="db-td-center">' + no + '</td>' +
                '<td class="db-td-bold" style="color:#ea580c;font-family:monospace;">' + d.noDRS + '</td>' +
                '<td style="color:#1e293b;">' + d.namaKantor + '</td>' +
                '<td style="font-weight:600;color:#0f172a;">' + d.namaOranger + '</td>' +
                '<td style="color:#334155;">' + d.tanggalTugas + '</td>' +
                '<td class="db-td-center" style="font-weight:600;color:#1e293b;">' + (d.totalKiriman || 0) + ' Kiriman</td>' +
                '<td>' + getBadgeDrs(d.statusDRS) + '</td>' +
                '<td style="font-size:.8rem;color:#64748b;">' + d.createdAt + '</td>' +
                '<td class="db-td-right">' +
                    '<div class="db-action-btns" style="justify-content:flex-end;">' +
                        '<button class="db-btn-icon detail-drs" data-id="' + d.id + '" title="Lihat Detail DRS"><i class="fas fa-eye"></i></button>' +
                        '<button class="db-btn-icon danger delete-drs" data-id="' + d.id + '" data-no="' + esc(d.noDRS) + '" title="Hapus"><i class="fas fa-trash"></i></button>' +
                    '</div>' +
                '</td>' +
            '</tr>';
        }
    });

    $('#drsStatusFilter').on('change', function () {
        drsTable.statusFilter = $(this).val();
        drsTable.applyFilter();
    });

    function loadOrangers() {
        $.ajax({
            url: window.API_BASE_URL + '/api/drs/orangers',
            type: 'GET',
            contentType: 'application/json',
            success: function (data) {
                eligibleOrangers = data;
                var optHtml = '<option value="">-- Pilih Oranger --</option>';
                for (var i = 0; i < data.length; i++) {
                    var o = data[i];
                    var typeLabel = o.roleType === 1 ? ' (Mobile)' : ' (Mobile & Web)';
                    optHtml += '<option value="' + o.id + '">' + o.namaLengkap + ' - ' + o.roleName + typeLabel + '</option>';
                }
                $('#createOrangerId, #editOrangerId').html(optHtml);
            }
        });
    }

    function getWibDateString() {
        var d = new Date();
        // Convert to WIB (UTC+7)
        var utc = d.getTime() + (d.getTimezoneOffset() * 60000);
        var wibDate = new Date(utc + (3600000 * 7));
        var yyyy = wibDate.getFullYear();
        var mm = String(wibDate.getMonth() + 1).padStart(2, '0');
        var dd = String(wibDate.getDate()).padStart(2, '0');
        return yyyy + '-' + mm + '-' + dd;
    }

    var defaultToday = getWibDateString();
    $('#drsTglAwal').val(defaultToday);
    $('#drsTglAkhir').val(defaultToday);

    function loadDrs() {
        var tglAwal = $('#drsTglAwal').val();
        var tglAkhir = $('#drsTglAkhir').val();
        var params = [];
        if (tglAwal) params.push('tglAwal=' + encodeURIComponent(tglAwal));
        if (tglAkhir) params.push('tglAkhir=' + encodeURIComponent(tglAkhir));
        var qs = params.length > 0 ? '?' + params.join('&') : '';

        $.ajax({
            url: window.API_BASE_URL + '/api/drs' + qs,
            type: 'GET',
            contentType: 'application/json',
            success: function (data) {
                rawDrsList = data;
                drsTable.setData(data);
            },
            error: function () {
                showAlert('Gagal memuat data DRS dari server backend.', 'danger');
            }
        });
    }

    $('#btnFilterDrsDate').on('click', function () {
        loadDrs();
    });
    $('#drsTglAwal, #drsTglAkhir').on('change', function () {
        loadDrs();
    });

    // Submit Create DRS
    $('#formCreateDrs').on('submit', function (e) {
        e.preventDefault();
        var payload = {
            noDRS: $('#createNoDRS').val().trim(),
            orangerId: parseInt($('#createOrangerId').val()),
            tanggalTugas: $('#createTanggalTugas').val(),
            statusDRS: $('#createStatusDRS').val()
        };

        $.ajax({
            url: window.API_BASE_URL + '/api/drs',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                closeModal('modalCreateDrs');
                $('#formCreateDrs')[0].reset();
                showAlert('Delivery Run Sheet berhasil dibuat.', 'success');
                loadDrs();
            },
            error: function (xhr) {
                var msg = xhr.responseJSON ? xhr.responseJSON.message : 'Gagal membuat DRS.';
                showAlert(msg || 'Gagal membuat DRS.', 'danger');
            }
        });
    });

    // Navigate to Detail DRS Page
    $(document).on('click', '.detail-drs', function () {
        var id = $(this).data('id');
        window.location.href = '/Admin/DrsDetail/' + id;
    });

    // Open Delete DRS Modal
    $(document).on('click', '.delete-drs', function () {
        drsToDeleteId = $(this).data('id');
        $('#deleteDrsNo').text($(this).data('no'));
        openModal('modalDeleteDrs');
    });

    // Confirm Delete DRS
    $('#btnConfirmDeleteDrs').on('click', function () {
        if (!drsToDeleteId) return;

        $.ajax({
            url: window.API_BASE_URL + '/api/drs/' + drsToDeleteId,
            type: 'DELETE',
            success: function () {
                closeModal('modalDeleteDrs');
                showAlert('Delivery Run Sheet berhasil dihapus.', 'success');
                loadDrs();
            },
            error: function (xhr) {
                closeModal('modalDeleteDrs');
                var msg = xhr.responseJSON ? xhr.responseJSON.message : 'Gagal menghapus DRS.';
                showAlert(msg || 'Gagal menghapus DRS.', 'danger');
            }
        });
    });

    // Initial Load
    loadKantorInfo();
    loadOrangers();
    loadDrs();
});
</script>
}
