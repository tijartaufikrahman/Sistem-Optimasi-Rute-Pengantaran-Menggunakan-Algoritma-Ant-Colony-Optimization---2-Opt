@{
    ViewData["Title"] = "Database";
}

<div id="dbAlertArea"></div>

<div class="row">
    <div class="col-12">
        <div class="db-data-card">
            <div class="db-card-top">
                <h3 class="db-card-title"><i class="fas fa-users" style="color:#ea580c;margin-right:.45rem;"></i> Tabel Users</h3>
                <button class="db-btn-primary" onclick="openModal('modalCreateUser')"><i class="fas fa-plus"></i> Tambah User</button>
            </div>
            <div class="db-card-controls">
                <div class="db-controls-left">
                    <span>Tampilkan</span>
                    <select id="usersLength" class="db-select"></select>
                </div>
                <div class="db-controls-right">
                    <span>Cari:</span>
                    <input id="usersSearch" class="db-input-search" type="text" placeholder="" />
                </div>
            </div>
            <div class="db-table-wrap">
                <table id="tableUsers" class="db-table">
                    <thead>
                        <tr>
                            <th class="db-th-center" style="width:60px;">#</th>
                            <th class="db-th-sortable">NAMA LENGKAP</th>
                            <th class="db-th-sortable">EMAIL</th>
                            <th class="db-th-sortable">ROLE</th>
                            <th class="db-th-sortable">STATUS</th>
                            <th class="db-th-sortable">DIBUAT</th>
                            <th class="db-th-right">AKSI</th>
                        </tr>
                    </thead>
                    <tbody id="usersBody"></tbody>
                </table>
            </div>
            <div class="db-card-footer">
                <div class="db-info-text" id="usersInfo">Menampilkan 0 - 0 dari 0 data</div>
                <div class="db-pagination" id="usersPaginate"></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="db-data-card">
            <div class="db-card-top">
                <h3 class="db-card-title"><i class="fas fa-shield-alt" style="color:#ea580c;margin-right:.45rem;"></i> Tabel Roles</h3>
