@section Scripts {
<script>
$(function () {

    var allRoles = [];

    function esc(str) {
        if (!str) return '';
        return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
    }

    function DbTable(config) {
        this.config = config;
        this.data = [];
        this.filtered = [];
        this.page = 1;
        this.perPage = 10;
        this.sortCol = -1;
        this.sortAsc = true;
        this.search = '';
    }
    DbTable.prototype = {
        setData: function (data) {
            this.data = data;
            this.applyFilter();
        },
        applyFilter: function () {
            var s = this.search.toLowerCase();
            this.filtered = s ? this.data.filter(function (row) {
                return Object.values(row).join(' ').toLowerCase().indexOf(s) > -1;
            }) : this.data.slice();
            if (this.sortCol > -1) {
                var col = this.config.sortKeys[this.sortCol];
                var asc = this.sortAsc;
                this.filtered.sort(function (a, b) {
                    var va = (a[col] || '').toString().toLowerCase();
                    var vb = (b[col] || '').toString().toLowerCase();
                    return asc ? va.localeCompare(vb) : vb.localeCompare(va);
                });
            }
            this.page = 1;
            this.render();
        },
        goTo: function (p) {
            var total = Math.ceil(this.filtered.length / this.perPage);
            if (p < 1) p = 1;
            if (p > total) p = total;
            this.page = p;
            this.render();
        },
        render: function () {
            var c = this.config;
            var start = (this.page - 1) * this.perPage;
            var end = start + this.perPage;
            var rows = this.filtered.slice(start, end);

            var html = '';
            if (rows.length === 0) {
                html = '<tr><td colspan="' + c.colCount + '" style="text-align:center;padding:2rem;color:#94a3b8;">Tidak ada data tersedia</td></tr>';
            } else {
                for (var i = 0; i < rows.length; i++) {
                    html += c.renderRow(rows[i], start + i + 1);
                }
            }
            $(c.tbody).html(html);

            var total = this.filtered.length;
            var infoText = total === 0
                ? 'Tidak ada data'
                : 'Menampilkan ' + (start + 1) + ' - ' + Math.min(end, total) + ' dari ' + total + ' data';
            $(c.info).text(infoText);

            var $len = $(c.lengthSel);
            if ($len.children().length === 0) {
                $len.html('<option value="10">10</option><option value="25">25</option><option value="50">50</option>');
                $len.val(this.perPage);
                $len.on('change', function () {
                    this.perPage = parseInt($(this).val());
                    this.page = 1;
                    this.render();
                }.bind(this));
            }

            var $search = $(c.searchInput);
            $search.off('input').on('input', function () {
                this.search = $(this).val();
                this.applyFilter();
            }.bind(this));

            var totalPages = Math.ceil(total / this.perPage) || 1;
            var pagHtml = '';
            pagHtml += '<button class="db-page-btn" data-p="1" ' + (this.page === 1 ? 'disabled' : '') + '>Awal</button>';
            pagHtml += '<button class="db-page-btn" data-p="' + (this.page - 1) + '" ' + (this.page === 1 ? 'disabled' : '') + '><i class="fas fa-chevron-left"></i></button>';
            for (var p = 1; p <= totalPages; p++) {
                if (totalPages > 7 && p > 3 && p < totalPages - 2 && Math.abs(p - this.page) > 1) {
                    if (p === 4 || p === totalPages - 3) pagHtml += '<span style="padding:0 4px;color:#94a3b8;">...</span>';
                    continue;
                }
                pagHtml += '<button class="db-page-btn' + (p === this.page ? ' active' : '') + '" data-p="' + p + '">' + p + '</button>';
            }
            pagHtml += '<button class="db-page-btn" data-p="' + (this.page + 1) + '" ' + (this.page === totalPages ? 'disabled' : '') + '><i class="fas fa-chevron-right"></i></button>';
            pagHtml += '<button class="db-page-btn" data-p="' + totalPages + '" ' + (this.page === totalPages ? 'disabled' : '') + '>Akhir</button>';
            $(c.paginate).html(pagHtml);

            $(c.paginate).off('click', '.db-page-btn').on('click', '.db-page-btn', function () {
                var p = parseInt($(this).data('p'));
                if (!isNaN(p)) this.goTo(p);
            }.bind(this));

            $(c.table).find('thead th.db-th-sortable').off('click').on('click', function () {
                var idx = $(c.table).find('thead th.db-th-sortable').index(this);
                if (this.sortCol === idx) {
                    this.sortAsc = !this.sortAsc;
                } else {
                    this.sortCol = idx;
                    this.sortAsc = true;
                }
                this.applyFilter();
            }.bind(this));
        }
    };

    var usersTable = new DbTable({
        tbody: '#usersBody',
        info: '#usersInfo',
        lengthSel: '#usersLength',
        searchInput: '#usersSearch',
        paginate: '#usersPaginate',
        table: '#tableUsers',
        colCount: 7,
        sortKeys: ['id', 'namaLengkap', 'email', 'roleName', 'isActive', 'createdAt'],
        renderRow: function (u, no) {
            var status = u.isActive
                ? '<span class="db-badge db-badge-green"><i class="fas fa-check"></i> Aktif</span>'
                : '<span class="db-badge db-badge-red"><i class="fas fa-times"></i> Nonaktif</span>';
            return '<tr>' +
                '<td class="db-td-center">' + no + '</td>' +
                '<td class="db-td-bold">' + u.namaLengkap + '</td>' +
                '<td>' + u.email + '</td>' +
                '<td><span class="db-badge db-badge-green">' + u.roleName + '</span></td>' +
                '<td>' + status + '</td>' +
                '<td>' + u.createdAt + '</td>' +
                '<td><div class="db-action-btns">' +
                    '<button class="db-btn-icon" onclick="openEditUser(' + u.id + ',\'' + esc(u.namaLengkap) + '\',\'' + esc(u.email) + '\',' + u.roleId + ',' + u.isActive + ')"><i class="fas fa-pen"></i> Edit</button>' +
                    '<button class="db-btn-icon danger" onclick="confirmDelete(\'/api/admin/users/' + u.id + '\',\'' + esc(u.namaLengkap) + '\', \'DELETE\')"><i class="fas fa-trash"></i> Hapus</button>' +
                '</div></td></tr>';
        }
    });

    var rolesTable = new DbTable({
        tbody: '#rolesBody',
        info: '#rolesInfo',
        lengthSel: '#rolesLength',
        searchInput: '#rolesSearch',
        paginate: '#rolesPaginate',
        table: '#tableRoles',
        colCount: 4,
        sortKeys: ['id', 'namaRole', 'deskripsi'],
        renderRow: function (r, no) {
            return '<tr>' +
                '<td class="db-td-center">' + no + '</td>' +
                '<td class="db-td-bold">' + r.namaRole + '</td>' +
                '<td>' + r.deskripsi + '</td>' +
                '<td><div class="db-action-btns">' +
                    '<button class="db-btn-icon" onclick="openEditRole(' + r.id + ',\'' + esc(r.namaRole) + '\',\'' + esc(r.deskripsi) + '\')"><i class="fas fa-pen"></i> Edit</button>' +
                    '<button class="db-btn-icon danger" onclick="confirmDelete(\'/api/admin/roles/' + r.id + '\',\'' + esc(r.namaRole) + '\', \'DELETE\')"><i class="fas fa-trash"></i> Hapus</button>' +
                '</div></td></tr>';
        }
    });

    var menuRolesTable = new DbTable({
        tbody: '#menuRolesBody',
        info: '#menuRolesInfo',
        lengthSel: '#menuRolesLength',
        searchInput: '#menuRolesSearch',
        paginate: '#menuRolesPaginate',
        table: '#tableMenuRoles',
        colCount: 7,
        sortKeys: ['id', 'roleName', 'namaMenu', 'icon', 'url', 'urutan'],
        renderRow: function (m, no) {
            return '<tr>' +
                '<td class="db-td-center">' + no + '</td>' +
                '<td>' + m.roleName + '</td>' +
                '<td class="db-td-bold">' + m.namaMenu + '</td>' +
                '<td><i class="' + m.icon + '"></i> <span style="color:#94a3b8;font-size:.72rem;">' + m.icon + '</span></td>' +
                '<td><code style="font-size:.72rem;color:#6366f1;">' + m.url + '</code></td>' +
                '<td class="db-td-center">' + m.urutan + '</td>' +
                '<td><div class="db-action-btns">' +
                    '<button class="db-btn-icon" onclick="openEditMenuRole(' + m.id + ',' + m.roleId + ',\'' + esc(m.namaMenu) + '\',\'' + esc(m.icon) + '\',\'' + esc(m.url) + '\',' + m.urutan + ')"><i class="fas fa-pen"></i> Edit</button>' +
                    '<button class="db-btn-icon danger" onclick="confirmDelete(\'/api/admin/menu-roles/' + m.id + '\',\'' + esc(m.namaMenu) + '\', \'DELETE\')"><i class="fas fa-trash"></i> Hapus</button>' +
                '</div></td></tr>';
        }
    });

    // Load Data via jQuery AJAX ke Backend REST API
    function loadAll() {
        $.ajax({
            url: window.API_BASE_URL + '/api/admin/users',
            type: 'GET',
            contentType: 'application/json',
            success: function (data) { usersTable.setData(data); }
        });
        $.ajax({
            url: window.API_BASE_URL + '/api/admin/roles',
            type: 'GET',
            contentType: 'application/json',
            success: function (data) {
                allRoles = data;
                rolesTable.setData(data);
                populateSelects();
            }
        });
        $.ajax({
            url: window.API_BASE_URL + '/api/admin/menu-roles',
            type: 'GET',
            contentType: 'application/json',
            success: function (data) { menuRolesTable.setData(data); }
        });
    }

    function populateSelects() {
        var opts = '<option value="">-- Pilih Role --</option>';
        for (var i = 0; i < allRoles.length; i++) {
            opts += '<option value="' + allRoles[i].id + '">' + allRoles[i].namaRole + '</option>';
        }
        $('#createUserRole, #editUserRole, #createMenuRoleRoleId, #editMenuRoleRoleId').html(opts);
    }

    function resetModalForm(id) {
        var $m = $('#' + id);
        $m.find('form').each(function () { this.reset(); });
        $m.find('.form-control').removeClass('is-invalid is-valid');
    }

    window.openModal = function (id) { $('#' + id).addClass('active'); };
    window.closeModal = function (id) { resetModalForm(id); $('#' + id).removeClass('active'); };
    $(document).on('click', '.modal-overlay', function (e) {
        if (e.target === this) { resetModalForm(this.id); $(this).removeClass('active'); }
    });
    $(document).on('keydown', function (e) {
        if (e.key === 'Escape') {
            $('.modal-overlay.active').each(function () { resetModalForm(this.id); $(this).removeClass('active'); });
        }
    });

    function showAlert(type, message) {
        var icon = type === 'success' ? 'check-circle' : 'exclamation-circle';
        $('#dbAlertArea').html('<div class="alert alert-' + type + ' db-alert"><i class="fas fa-' + icon + '"></i> ' + message + '</div>');
        setTimeout(function () { $('#dbAlertArea .db-alert').fadeOut(300, function () { $(this).remove(); }); }, 4000);
    }

    // Fungsi Standar jQuery AJAX ke Backend REST API
    function callApi(url, method, data, cb) {
        $.ajax({
            url: window.API_BASE_URL + url,
            type: method,
            contentType: 'application/json',
            data: data ? JSON.stringify(data) : null,
            success: function (res) {
                if (res.success !== false) {
                    if (cb) cb();
                    showAlert('success', res.message || 'Operasi berhasil.');
                    setTimeout(loadAll, 400);
                } else {
                    showAlert('danger', res.message || 'Terjadi kesalahan.');
                }
            },
            error: function (xhr) {
                var msg = 'Terjadi kesalahan komunikasi dengan server Backend.';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    msg = xhr.responseJSON.message;
                }
                showAlert('danger', msg);
            }
        });
    }

    window.openEditUser = function (id, name, email, roleId, isActive) {
        $('#editUserId').val(id);
        $('#editUserName').val(name.replace(/\\'/g, "'"));
        $('#editUserEmail').val(email.replace(/\\'/g, "'"));
        $('#editUserRole').val(roleId);
        $('#editUserActive').val(isActive ? 'true' : 'false');
        openModal('modalEditUser');
    };
    window.openEditRole = function (id, name, desc) {
        $('#editRoleId').val(id);
        $('#editRoleName').val(name.replace(/\\'/g, "'"));
        $('#editRoleDesc').val(desc.replace(/\\'/g, "'"));
        openModal('modalEditRole');
    };
    window.openEditMenuRole = function (id, roleId, name, icon, url, urutan) {
        $('#editMenuRoleId').val(id);
        $('#editMenuRoleRoleId').val(roleId);
        $('#editMenuRoleName').val(name.replace(/\\'/g, "'"));
        var iconVal = icon.replace(/\\'/g, "'");
        $('#editMenuRoleIcon').val(iconVal);
        $('#editMenuRoleIconPreview').attr('class', iconVal || 'fas fa-home');
        $('#editMenuRoleIconText').text(iconVal || '-');
        $('#editMenuRoleUrl').val(url.replace(/\\'/g, "'"));
        $('#editMenuRoleUrutan').val(urutan);
        openModal('modalEditMenuRole');
    };

    window.confirmDelete = function (apiEndpoint, name, method) {
        $('#deleteItemName').text(name.replace(/\\'/g, "'"));
        $('#btnConfirmDelete').off('click').on('click', function () {
            callApi(apiEndpoint, method || 'DELETE', null, function () { closeModal('modalConfirmDelete'); });
        });
        openModal('modalConfirmDelete');
    };

    // FORM SUBMISSIONS MENGGUNAKAN $.ajax DENGAN contentType: 'application/json'
    $('#formCreateUser').on('submit', function (e) {
        e.preventDefault();
        var payload = {
            NamaLengkap: $(this).find('[name="NamaLengkap"]').val(),
            Email: $(this).find('[name="Email"]').val(),
            Password: $(this).find('[name="Password"]').val(),
            ConfirmPassword: $(this).find('[name="ConfirmPassword"]').val(),
            RoleId: parseInt($(this).find('[name="RoleId"]').val()) || 0
        };
        callApi('/api/admin/users', 'POST', payload, function () { closeModal('modalCreateUser'); });
    });

    $('#formEditUser').on('submit', function (e) {
        e.preventDefault();
        var id = parseInt($('#editUserId').val());
        var payload = {
            Id: id,
            NamaLengkap: $('#editUserName').val(),
            Email: $('#editUserEmail').val(),
            Password: $(this).find('[name="Password"]').val() || null,
            RoleId: parseInt($('#editUserRole').val()) || 0,
            IsActive: $('#editUserActive').val() === 'true'
        };
        callApi('/api/admin/users/' + id, 'PUT', payload, function () { closeModal('modalEditUser'); });
    });

    $('#formCreateRole').on('submit', function (e) {
        e.preventDefault();
        var payload = {
            NamaRole: $(this).find('[name="NamaRole"]').val(),
            Deskripsi: $(this).find('[name="Deskripsi"]').val()
        };
        callApi('/api/admin/roles', 'POST', payload, function () { closeModal('modalCreateRole'); });
    });

    $('#formEditRole').on('submit', function (e) {
        e.preventDefault();
        var id = parseInt($('#editRoleId').val());
        var payload = {
            Id: id,
            NamaRole: $('#editRoleName').val(),
            Deskripsi: $('#editRoleDesc').val()
        };
        callApi('/api/admin/roles/' + id, 'PUT', payload, function () { closeModal('modalEditRole'); });
    });

    $('#formCreateMenuRole').on('submit', function (e) {
        e.preventDefault();
        var payload = {
            RoleId: parseInt($('#createMenuRoleRoleId').val()) || 0,
            NamaMenu: $(this).find('[name="NamaMenu"]').val(),
            Icon: $('#createMenuRoleIcon').val(),
            Url: $(this).find('[name="Url"]').val(),
            Urutan: parseInt($(this).find('[name="Urutan"]').val()) || 0
        };
        callApi('/api/admin/menu-roles', 'POST', payload, function () { closeModal('modalCreateMenuRole'); });
    });

    $('#formEditMenuRole').on('submit', function (e) {
        e.preventDefault();
        var id = parseInt($('#editMenuRoleId').val());
        var payload = {
            Id: id,
            RoleId: parseInt($('#editMenuRoleRoleId').val()) || 0,
            NamaMenu: $('#editMenuRoleName').val(),
            Icon: $('#editMenuRoleIcon').val(),
            Url: $('#editMenuRoleUrl').val(),
            Urutan: parseInt($('#editMenuRoleUrutan').val()) || 0
        };
        callApi('/api/admin/menu-roles/' + id, 'PUT', payload, function () { closeModal('modalEditMenuRole'); });
    });

