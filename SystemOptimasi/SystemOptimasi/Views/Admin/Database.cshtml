    var iconPickerTarget = null;

    window.openIconPicker = function (inputId) {
        iconPickerTarget = inputId;
        var currentVal = $('#' + inputId).val();
        var $grid = $('#iconPickerGrid');
        $grid.empty();
        for (var i = 0; i < iconPickerIcons.length; i++) {
            var cls = iconPickerIcons[i];
            var sel = cls === currentVal ? ' selected' : '';
            $grid.append('<div class="icon-picker-item' + sel + '" data-icon="' + cls + '" title="' + cls + '"><i class="' + cls + '"></i></div>');
        }
        $('#iconPickerSearch').val('');
        filterIconPicker('');
        $('#iconPickerModal').addClass('active');
    };

    window.closeIconPicker = function () {
        $('#iconPickerModal').removeClass('active');
        iconPickerTarget = null;
    };

    $(document).on('click', '.icon-picker-item', function () {
        var cls = $(this).data('icon');
        if (!iconPickerTarget) return;
        $('#' + iconPickerTarget).val(cls);
        var previewId = iconPickerTarget + 'Preview';
        var textId = iconPickerTarget + 'Text';
        $('#' + previewId).attr('class', cls);
        var $text = $('#' + textId);
        if ($text.length) $text.text(cls);
        else $('#' + previewId).next('span').text(cls);
        closeIconPicker();
    });

    $('#iconPickerSearch').on('input', function () {
        filterIconPicker($(this).val().toLowerCase());
    });

    function filterIconPicker(q) {
        $('#iconPickerGrid .icon-picker-item').each(function () {
            var icon = $(this).data('icon').toLowerCase();
            $(this).toggle(icon.indexOf(q) > -1);
        });
    }

    $(document).on('click', '#iconPickerModal', function (e) {
        if (e.target === this) closeIconPicker();
    });

    loadAll();

});
