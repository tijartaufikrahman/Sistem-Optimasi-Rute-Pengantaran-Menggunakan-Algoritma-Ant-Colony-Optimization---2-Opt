@{
    ViewData["Title"] = "Email Terkirim";
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Terkirim - Sistem Optimasi Distribusi</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', system-ui, sans-serif; min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            background: #f1f5f9; padding: 20px;
        }
        .card {
            width: 100%; max-width: 420px; background: #fff; border-radius: 20px;
            box-shadow: 0 10px 40px rgba(15,23,42,.08); padding: 44px 36px 36px;
            text-align: center; border: 1px solid rgba(15,23,42,.06);
        }
        .icon-wrap {
            width: 72px; height: 72px; background: linear-gradient(135deg,#34d399,#059669);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 20px; box-shadow: 0 8px 24px rgba(5,150,105,.25);
        }
        .icon-wrap i { font-size: 32px; color: #fff; }
        h1 { font-size: 20px; color: #0f172a; font-weight: 700; margin-bottom: 12px; }
        p { color: #64748b; font-size: 13.5px; line-height: 1.7; margin-bottom: 8px; }
        .btn {
            display: inline-flex; align-items: center; gap: 8px;
            margin-top: 24px; padding: 12px 28px;
            background: linear-gradient(135deg,#6366f1,#4f46e5);
            color: #fff; text-decoration: none; border-radius: 12px;
            font-weight: 600; font-size: 14px; box-shadow: 0 4px 14px rgba(79,70,229,.3);
            transition: all .25s;
        }
        .btn:hover { transform: translateY(-1px); }
        .hint { margin-top: 16px; font-size: 12px; color: #94a3b8; }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon-wrap"><i class="fas fa-envelope-circle-check"></i></div>
        <h1>Email Terkirim!</h1>
        <p>@(TempData["ForgotPasswordSuccess"] ?? "Link reset password telah dikirim ke email Anda.")</p>
        <p>Silakan periksa <strong>inbox</strong> atau folder <strong>spam</strong> Anda.</p>
        <a asp-action="Login" asp-controller="Account" class="btn">
            <i class="fas fa-arrow-left"></i> Kembali ke Login
        </a>
        <div class="hint">Link reset berlaku selama 1 jam.</div>
    </div>
</body>
</html>


